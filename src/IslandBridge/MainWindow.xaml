<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="IslandBridge.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:IslandBridge.Controls">
    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>
    <Grid x:Name="Root" KeyDown="OnRootKeyDown">
        <Grid.Resources>
            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Opacity" Value="0.65" />
                <Setter Property="Margin" Value="0,0,0,2" />
            </Style>
            <Style x:Key="RowLabel" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
            <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Padding" Value="8,4,8,5" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
            </Style>
            <Style x:Key="CaptionButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="32" />
                <Setter Property="Height" Value="28" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="16,14,16,10" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image x:Name="Logo" Width="30" Height="30" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="AppTitle" FontSize="15" FontWeight="SemiBold" />
                <TextBlock x:Name="StatusText" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Ellipse x:Name="StatusDot" Grid.Column="2" Width="10" Height="10" VerticalAlignment="Center" />
            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Top" Margin="0,-8,-10,0">
                <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" TabIndex="100" Click="OnMinimizeClick">
                    <FontIcon Glyph="&#xE921;" FontSize="10" />
                </Button>
                <Button x:Name="CloseButton" Style="{StaticResource CaptionButton}" TabIndex="101" Click="OnCloseClick">
                    <FontIcon Glyph="&#xE8BB;" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Padding="16,0,16,12" Spacing="18">
                <InfoBar x:Name="HintBar" IsClosable="False" IsOpen="False" Padding="0" />

                <StackPanel Spacing="6">
                    <TextBlock x:Name="NotificationsHeader" Style="{StaticResource SectionHeader}" />
                    <controls:Segmented x:Name="PauseSegments" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="IgnoreSilentLabel" Style="{StaticResource RowLabel}" />
                        <ToggleSwitch x:Name="IgnoreSilentSwitch" Grid.Column="1" Toggled="OnIgnoreSilentToggled" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="PreviewsLabel" Style="{StaticResource RowLabel}" />
                        <ToggleSwitch x:Name="PreviewsSwitch" Grid.Column="1" Toggled="OnPreviewsToggled" />
                    </Grid>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="WindowsToastsLabel" Style="{StaticResource RowLabel}" />
                        <ToggleSwitch x:Name="WindowsToastsSwitch" Grid.Column="1" Toggled="OnWindowsToastsToggled" />
                    </Grid>
                    <TextBlock x:Name="WindowsToastsWarning" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <Grid>
                        <TextBlock x:Name="RecentHeader" Style="{StaticResource SectionHeader}" VerticalAlignment="Center" />
                        <Button x:Name="RecentToggle" Style="{StaticResource SmallButton}" HorizontalAlignment="Right" Visibility="Collapsed" Click="OnRecentToggleClick">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="RecentToggleText" FontSize="12" VerticalAlignment="Center" />
                                <FontIcon x:Name="RecentToggleIcon" Glyph="&#xE70D;" FontSize="10" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <TextBlock x:Name="RecentEmpty" FontSize="12" Opacity="0.6" />
                    <ScrollViewer x:Name="RecentScroller" MaxHeight="264" VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                        <StackPanel x:Name="RecentList" Spacing="4" />
                    </ScrollViewer>
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock x:Name="DeviceHeader" Style="{StaticResource SectionHeader}" />
                    <TextBlock x:Name="DeviceName" FontSize="13" FontWeight="SemiBold" />
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="FindButton" Style="{StaticResource SmallButton}" Click="OnFindClick" />
                        <Button x:Name="ReconnectButton" Grid.Column="1" Style="{StaticResource SmallButton}" Click="OnReconnectClick" />
                        <Button x:Name="ForgetButton" Grid.Column="2" Style="{StaticResource SmallButton}" Click="OnForgetClick" />
                    </Grid>
                    <ProgressBar x:Name="SearchProgress" IsIndeterminate="True" Visibility="Collapsed" />
                    <TextBlock x:Name="SearchStatus" FontSize="12" Opacity="0.75" TextWrapping="Wrap" Visibility="Collapsed" />
                    <StackPanel x:Name="Candidates" Spacing="4" />
                    <TextBlock x:Name="DeviceHelp" FontSize="12" Opacity="0.75" TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock x:Name="StartupHeader" Style="{StaticResource SectionHeader}" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="AutostartLabel" Style="{StaticResource RowLabel}" />
                        <ToggleSwitch x:Name="AutostartSwitch" Grid.Column="1" Toggled="OnAutostartToggled" />
                    </Grid>
                    <TextBlock x:Name="AutostartWarning" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="Collapsed" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MinimizedLabel" Style="{StaticResource RowLabel}" />
                        <ToggleSwitch x:Name="MinimizedSwitch" Grid.Column="1" Toggled="OnMinimizedToggled" />
                    </Grid>
                    <TextBlock x:Name="CloseActionLabel" FontSize="13" />
                    <controls:Segmented x:Name="CloseActionSegments" />
                    <TextBlock x:Name="DelayLabel" FontSize="13" />
                    <controls:Segmented x:Name="DelaySegments" />
                </StackPanel>

                <StackPanel Spacing="6">
                    <TextBlock x:Name="AppearanceHeader" Style="{StaticResource SectionHeader}" />
                    <TextBlock x:Name="LanguageLabel" FontSize="13" />
                    <controls:Segmented x:Name="LanguageSegments" />
                    <TextBlock x:Name="ThemeLabel" FontSize="13" />
                    <controls:Segmented x:Name="ThemeSegments" />
                </StackPanel>

                <Expander x:Name="FiltersExpander" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <StackPanel Spacing="6">
                        <TextBlock x:Name="CategoriesHeader" Style="{StaticResource SectionHeader}" />
                        <VariableSizedWrapGrid x:Name="CategoryList" Orientation="Horizontal" ItemWidth="150" />
                        <TextBlock x:Name="AppsHeader" Margin="0,8,0,0" Style="{StaticResource SectionHeader}" />
                        <TextBlock x:Name="AppsEmpty" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
                        <StackPanel x:Name="AppList" />
                    </StackPanel>
                </Expander>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Padding="16,8,16,12" ColumnSpacing="8" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="VersionText" FontSize="12" Opacity="0.6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <HyperlinkButton x:Name="LogsButton" Grid.Column="1" FontSize="12" Padding="6,4,6,4" Click="OnLogsClick" />
            <Button x:Name="ExitButton" Grid.Column="2" Style="{StaticResource SmallButton}" Click="OnExitClick" />
        </Grid>
    </Grid>
</Window>
