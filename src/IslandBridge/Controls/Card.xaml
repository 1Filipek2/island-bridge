<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="IslandBridge.Controls.Card"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        Padding="12,8,12,8"
        CornerRadius="6"
        BorderThickness="1"
        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="1" VerticalAlignment="Center">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="HeadingText" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MetaText" Grid.Column="1" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                </Grid>
                <TextBlock x:Name="BodyText" FontSize="12" Opacity="0.85" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <Button x:Name="ActionButton" Grid.Column="1" Padding="10,3,10,4" FontSize="12" VerticalAlignment="Center" Visibility="Collapsed" Click="OnActionClick" />
        </Grid>
    </Border>
</UserControl>
